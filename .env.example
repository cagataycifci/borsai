# Borsa AI Terminal — environment template. Copy to .env and adjust.
# Real API keys are NOT stored here; they are entered in Settings and encrypted.

# Engine
BORSA_ENGINE_HOST=127.0.0.1
BORSA_ENGINE_PORT=8787
BORSA_LOG_LEVEL=INFO

# Optional: free data provider keys (can also be set in Settings UI)
# FINNHUB_API_KEY=
